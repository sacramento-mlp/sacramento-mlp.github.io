---
import { locale, localPath } from '../lib/locale';
const lang=locale(Astro.url.pathname);
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
---
<footer>
  <div class="wrap footer-inner">
    <span>© {new Date().getFullYear()} Mário Sacramento</span>
    {home ?
      <span data-pt="Desenvolvido com Astro · Alojado no GitHub Pages" data-en="Built with Astro · Hosted on GitHub Pages">{lang==='pt'?'Desenvolvido com Astro · Alojado no GitHub Pages':'Built with Astro · Hosted on GitHub Pages'}</span>
      : <span>{lang==='pt'?'SOLUÇÕES TECNOLÓGICAS':'TECHNOLOGY SOLUTIONS'}</span>
    }
    <a href={home ? '#inicio' : localPath('/',lang)} data-pt={home ? 'Voltar ao topo ↑' : 'Página inicial ↑'} data-en={home ? 'Back to top ↑' : 'Back to home ↑'}>{lang==='pt'?(home?'Voltar ao topo ↑':'Página inicial ↑'):(home?'Back to top ↑':'Back to home ↑')}</a>
  </div>
</footer>
