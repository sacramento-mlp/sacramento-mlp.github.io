---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import { experience, education, training, modules } from '../data/professional-profile';
const skills=[
 {n:'01',title:'Software development',pt:'Desenvolvimento de software',detail:'Python · Application architecture',detailPt:'Python · Arquitetura de aplicações'},
 {n:'02',title:'Windows automation',pt:'Automação Windows',detail:'PowerShell · Technical workflows',detailPt:'PowerShell · Fluxos técnicos'},
 {n:'03',title:'Systems administration',pt:'Administração de sistemas',detail:'Windows · Domain environments',detailPt:'Windows · Ambientes de domínio'}
];
---
<!doctype html><html lang="en" data-theme="dark"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="Mário Sacramento — professional profile, technical focus and software portfolio."/>
<link rel="canonical" href="https://sacramento-mlp.github.io/cv/"/>
<meta name="theme-color" content="#080f1d"/><link rel="icon" type="image/png" href="/brand/ms-logo.png"/>
<meta property="og:type" content="profile"/>
<meta property="og:title" content="Professional profile | Mário Sacramento"/>
<meta property="og:description" content="Mário Sacramento — professional profile, technical focus and software portfolio."/>
<meta property="og:url" content="https://sacramento-mlp.github.io/cv/"/>
<meta property="og:site_name" content="Mário Sacramento"/>
<meta property="og:locale" content="en_US"/>
<meta name="twitter:card" content="summary"/>
<meta name="twitter:title" content="Professional profile | Mário Sacramento"/>
<meta name="twitter:description" content="Professional profile, technical focus and software portfolio."/>
<title>Professional profile | Mário Sacramento</title>
<script is:inline src="/js/preferences-init.js"></script>
</head><body class="cv-page">
<a class="skip-link" href="#main-content" data-pt="Saltar para o conteúdo principal" data-en="Skip to main content">Skip to main content</a>
<SiteHeader current="cv" />
<main id="main-content" tabindex="-1">
<section class="cv-hero"><div class="wrap"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="PERFIL PROFISSIONAL" data-en="PROFESSIONAL PROFILE">PROFESSIONAL PROFILE</span></div>
<div class="cv-hero-grid"><div><h1 data-pt="Currículo profissional" data-en="Professional résumé">Professional résumé</h1><p class="cv-role" data-pt="Sistemas e Tecnologias de Informação" data-en="Information Systems & Technology">Information Systems & Technology</p><p class="lead" data-pt="Experiência em sistemas informáticos, suporte técnico, redes e telecomunicações desde 2013." data-en="Experience in IT systems, technical support, networks and telecommunications since 2013.">Experience in IT systems, technical support, networks and telecommunications since 2013.</p>
<div class="actions"><a class="btn" href="/#produtos"><span data-pt="Explorar projetos" data-en="Explore projects">Explore projects</span> ↗</a><a class="btn secondary" href="https://github.com/sacramento-mlp" rel="noopener noreferrer">GitHub ↗</a></div></div>
<div class="cv-identity" aria-label="Mário Sacramento MS brand symbol"><div class="cv-symbol-viewport"><img src="/brand/ms-logo.png" alt="" width="240" height="180" /></div></div></div></div></section>
<nav class="wrap cv-jump" aria-label="Résumé sections" data-aria-pt="Secções do currículo" data-aria-en="Résumé sections"><a href="#experiencia" data-pt="Experiência" data-en="Experience">Experience</a><a href="#formacao" data-pt="Formação" data-en="Education">Education</a><a href="/#produtos" data-pt="Projetos" data-en="Projects">Projects</a></nav>
<section class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="01 / RESUMO" data-en="01 / SUMMARY">01 / SUMMARY</span></div><div class="cv-two-col"><h2 data-pt="Tecnologia aplicada a necessidades concretas." data-en="Technology focused on real needs.">Technology focused on real needs.</h2><div><p class="lead" data-pt="Percurso em telecomunicações e sistemas informáticos no Exército Português e, desde novembro de 2026, na carreira de Técnico de Sistemas e Tecnologias de Informação na PSP." data-en="A career in telecommunications and IT systems in the Portuguese Army and, since November 2026, as an Information Systems and Technology Technician at the PSP.">A career in telecommunications and IT systems in the Portuguese Army and, since November 2026, as an Information Systems and Technology Technician at the PSP.</p><p class="muted" data-pt="Os projetos pessoais são independentes das funções profissionais." data-en="Personal projects are independent of professional employment.">Personal projects are independent of professional employment.</p></div></div></section>
<section class="section-alt"><div class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="02 / ÁREAS TÉCNICAS" data-en="02 / TECHNICAL FOCUS">02 / TECHNICAL FOCUS</span></div><h2 data-pt="Áreas de atuação" data-en="Areas of focus">Areas of focus</h2><div class="cv-skills">{skills.map(s=><article class="cv-skill"><span class="cv-skill-number">{s.n}</span><div><h3 data-pt={s.pt} data-en={s.title}>{s.title}</h3><p data-pt={s.detailPt} data-en={s.detail}>{s.detail}</p></div><span class="cv-skill-arrow" aria-hidden="true">↗</span></article>)}</div></div></section>
<section class="wrap section-space" id="experiencia"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="03 / EXPERIÊNCIA" data-en="03 / EXPERIENCE">03 / EXPERIENCE</span></div><h2 data-pt="Percurso profissional" data-en="Career history">Career history</h2><ol class="career-timeline">{experience.map(e=><li class="career-entry"><div><p class="muted" data-pt={e.period.pt} data-en={e.period.en}>{e.period.en}</p><h3 data-pt={e.role.pt} data-en={e.role.en}>{e.role.en}</h3><p data-pt={e.organization.pt} data-en={e.organization.en}>{e.organization.en}</p><p data-pt={e.description.pt} data-en={e.description.en}>{e.description.en}</p></div></li>)}</ol></section>
<section class="section-alt" id="formacao"><div class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="04 / FORMAÇÃO" data-en="04 / EDUCATION">04 / EDUCATION</span></div><h2 data-pt="Habilitações e formação" data-en="Education and training">Education and training</h2><div class="cv-skills education-grid">{education.map(e=><article class="cv-skill"><span class="cv-skill-number">{e.year}</span><div><h3 data-pt={e.pt} data-en={e.en}>{e.en}</h3><p>{e.institution}</p></div></article>)}{training.map(t=><article class="cv-skill"><span class="cv-skill-number">{t.year}</span><div><h3 data-pt={t.pt} data-en={t.en}>{t.en}</h3><p>{t.institution}</p><p class="muted" data-pt={t.note.pt} data-en={t.note.en}>{t.note.en}</p></div></article>)}</div><h3 data-pt="Formação modular certificada — INOVINTER" data-en="Certified modular training — INOVINTER">Certified modular training — INOVINTER</h3><details class="training-details"><summary><span data-pt="Consultar os 18 módulos (2022–2024)" data-en="View all 18 modules (2022–2024)">View all 18 modules (2022–2024)</span></summary><ul class="training-list">{modules.map(m=><li><span data-pt={m.pt} data-en={m.en}>{m.en}</span> · {m.year} · UFCD {m.code}</li>)}</ul></details></div></section>
<section class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="05 / PROJETOS" data-en="05 / SELECTED PROJECTS">05 / SELECTED PROJECTS</span></div><div class="cv-two-col"><div><h2 data-pt="Projetos que estou a desenvolver." data-en="Projects in development.">Projects in development.</h2><p class="muted" data-pt="Cada projeto tem a sua própria página, âmbito e estado de desenvolvimento." data-en="Each project has its own page, scope and development status.">Each project has its own page, scope and development status.</p></div><div class="cv-project-list"><a href="/produtos/diskguardian/"><span>DiskGuardian</span><span>↗</span></a><a href="/produtos/windows-technical-toolkit/"><span>Windows Technical Toolkit</span><span>↗</span></a><a href="/produtos/domain-admin-toolkit/"><span>Domain Admin Toolkit</span><span>↗</span></a></div></div></section>
<section class="cv-closing"><div class="wrap"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="06 / CONTACTO" data-en="06 / CONTACT">06 / CONTACT</span></div><h2 data-pt="Entrar em contacto." data-en="Get in touch.">Get in touch.</h2><p class="lead" data-pt="Para questões profissionais ou sobre projetos pessoais, utiliza o e-mail indicado." data-en="For professional enquiries or questions about personal projects, use the email below.">For professional enquiries or questions about personal projects, use the email below.</p><p><a href="mailto:sacramento.mlp.it@gmail.com">sacramento.mlp.it@gmail.com</a></p><a class="btn secondary" href="/" data-pt="Voltar ao portfólio" data-en="Back to portfolio">Back to portfolio</a></div></section>
</main><SiteFooter />
<script is:inline src="/js/preferences.js" defer></script></body></html>