---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
const skills=[
 {n:'01',title:'Software development',pt:'Desenvolvimento de software',detail:'Python · Application architecture',detailPt:'Python · Arquitetura de aplicações'},
 {n:'02',title:'Windows automation',pt:'Automação Windows',detail:'PowerShell · Technical workflows',detailPt:'PowerShell · Fluxos técnicos'},
 {n:'03',title:'Systems administration',pt:'Administração de sistemas',detail:'Windows · Domain environments',detailPt:'Windows · Ambientes de domínio'}
];
---
<!doctype html><html lang="en" data-theme="dark"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="Mário Sacramento — professional profile, technical focus and software portfolio."/>
<link rel="canonical" href="https://sacramento-mlp.github.io/cv/"/>
<meta name="theme-color" content="#080f1d"/><link rel="icon" type="image/png" href="/brand/ms-logo.png"/>
<meta property="og:type" content="profile"/>
<meta property="og:title" content="Professional profile | Mário Sacramento"/>
<meta property="og:description" content="Mário Sacramento — professional profile, technical focus and software portfolio."/>
<meta property="og:url" content="https://sacramento-mlp.github.io/cv/"/>
<meta property="og:site_name" content="Mário Sacramento"/>
<meta property="og:locale" content="en_US"/>
<meta name="twitter:card" content="summary"/>
<meta name="twitter:title" content="Professional profile | Mário Sacramento"/>
<meta name="twitter:description" content="Professional profile, technical focus and software portfolio."/>
<title>Professional profile | Mário Sacramento</title>
<script is:inline src="/js/preferences-init.js"></script>
</head><body class="cv-page">
<a class="skip-link" href="#main-content" data-pt="Saltar para o conteúdo principal" data-en="Skip to main content">Skip to main content</a>
<SiteHeader current="cv" />
<main id="main-content" tabindex="-1">
<section class="cv-hero"><div class="wrap"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="PERFIL PROFISSIONAL" data-en="PROFESSIONAL PROFILE">PROFESSIONAL PROFILE</span></div>
<div class="cv-hero-grid"><div><h1>Mário<br/>Sacramento<span class="gradient-text">.</span></h1><p class="cv-role" data-pt="Desenvolvimento de Software & Soluções IT" data-en="Software Development & IT Solutions">Software Development & IT Solutions</p><p class="lead" data-pt="Desenvolvimento de software, automação Windows e soluções técnicas para desafios reais." data-en="Software development, Windows automation and practical technical solutions for real-world challenges.">Software development, Windows automation and practical technical solutions for real-world challenges.</p>
<div class="actions"><a class="btn" href="/#produtos"><span data-pt="Explorar projetos" data-en="Explore projects">Explore projects</span> ↗</a><a class="btn secondary" href="https://github.com/sacramento-mlp" rel="noopener noreferrer">GitHub ↗</a></div></div>
<div class="cv-identity" aria-label="Mário Sacramento MS brand symbol"><div class="cv-symbol-viewport"><img src="/brand/ms-logo.png" alt="" width="240" height="180" /></div></div></div></div></section>
<section class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="01 / RESUMO" data-en="01 / SUMMARY">01 / SUMMARY</span></div><div class="cv-two-col"><h2 data-pt="Tecnologia aplicada a necessidades concretas." data-en="Technology focused on real needs.">Technology focused on real needs.</h2><div><p class="lead" data-pt="Este perfil reúne áreas de interesse técnico e projetos em desenvolvimento. A informação sobre experiência profissional, formação e certificações será acrescentada após confirmação." data-en="This profile brings together technical areas of focus and projects in development. Employment history, education and certifications will be added after verification.">This profile brings together technical areas of focus and projects in development. Employment history, education and certifications will be added after verification.</p><p class="muted" data-pt="As competências abaixo descrevem áreas de trabalho do portfólio, não certificações ou experiência profissional comprovada." data-en="The areas below describe the portfolio's technical focus, not verified certifications or employment experience.">The areas below describe the portfolio's technical focus, not verified certifications or employment experience.</p></div></div></section>
<section class="section-alt"><div class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="02 / ÁREAS TÉCNICAS" data-en="02 / TECHNICAL FOCUS">02 / TECHNICAL FOCUS</span></div><h2 data-pt="Áreas de atuação" data-en="Areas of focus">Areas of focus</h2><div class="cv-skills">{skills.map(s=><article class="cv-skill"><span class="cv-skill-number">{s.n}</span><div><h3 data-pt={s.pt} data-en={s.title}>{s.title}</h3><p data-pt={s.detailPt} data-en={s.detail}>{s.detail}</p></div><span class="cv-skill-arrow" aria-hidden="true">↗</span></article>)}</div></div></section>
<section class="wrap section-space" id="experiencia"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="03 / EXPERIÊNCIA PROFISSIONAL" data-en="03 / PROFESSIONAL EXPERIENCE">03 / PROFESSIONAL EXPERIENCE</span></div><div class="cv-two-col"><div><h2 data-pt="Experiência profissional" data-en="Professional experience">Professional experience</h2><p class="muted" data-pt="Percurso profissional em atualização. As responsabilidades abaixo descrevem o enquadramento geral da carreira, não uma lista de tarefas individuais confirmadas." data-en="Career history is being updated. The responsibilities below describe the general career framework, not a confirmed list of individual duties.">Career history is being updated. The responsibilities below describe the general career framework, not a confirmed list of individual duties.</p></div><div><article class="cv-skill"><span class="cv-skill-number">2026</span><div><h3 data-pt="Técnico de Sistemas e Tecnologias de Informação" data-en="Information Systems and Technology Technician">Information Systems and Technology Technician</h3><p>Polícia de Segurança Pública (PSP) · <span data-pt="Comando Distrital de Viana do Castelo" data-en="Viana do Castelo District Command">Viana do Castelo District Command</span></p><p data-pt="01/11/2026 — Presente · Trabalhador em funções públicas" data-en="1 Nov 2026 — Present · Public sector employee">1 Nov 2026 — Present · Public sector employee</p><p data-pt="Enquadramento funcional da carreira: apoio à administração, monitorização, manutenção e utilização de sistemas e tecnologias de informação, bem como participação na implementação e evolução de soluções tecnológicas. As funções concretas serão confirmadas posteriormente." data-en="General career framework: supporting the administration, monitoring, maintenance and use of information systems and technologies, and participating in the implementation and evolution of technology solutions. Specific duties will be confirmed later.">General career framework: supporting the administration, monitoring, maintenance and use of information systems and technologies, and participating in the implementation and evolution of technology solutions. Specific duties will be confirmed later.</p><p class="muted"><a href="https://www.dgaep.gov.pt/index.cfm?ID=105000000&amp;OBJID=b8a129f3-8eb7-4b56-932f-f084b9abab44" rel="noopener noreferrer" target="_blank" data-pt="Enquadramento legal da carreira (DGAEP) ↗" data-en="Career framework (DGAEP) ↗">Career framework (DGAEP) ↗</a></p></div></article></div></div></section>
<section class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="04 / PROJETOS" data-en="04 / SELECTED PROJECTS">04 / SELECTED PROJECTS</span></div><div class="cv-two-col"><div><h2 data-pt="Projetos que estou a desenvolver." data-en="Projects in development.">Projects in development.</h2><p class="muted" data-pt="Cada projeto tem a sua própria página, âmbito e estado de desenvolvimento." data-en="Each project has its own page, scope and development status.">Each project has its own page, scope and development status.</p></div><div class="cv-project-list"><a href="/produtos/diskguardian/"><span>DiskGuardian</span><span>↗</span></a><a href="/produtos/windows-technical-toolkit/"><span>Windows Technical Toolkit</span><span>↗</span></a><a href="/produtos/domain-admin-toolkit/"><span>Domain Admin Toolkit</span><span>↗</span></a></div></div></section>
<section class="cv-closing"><div class="wrap"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="05 / PRÓXIMOS PASSOS" data-en="05 / NEXT STEPS">05 / NEXT STEPS</span></div><h2 data-pt="Um currículo em construção." data-en="A profile taking shape.">A profile taking shape.</h2><p class="lead" data-pt="O histórico profissional, a formação e os contactos diretos serão publicados depois de revistos e autorizados." data-en="Career history, education and direct contact details will be published once reviewed and approved.">Career history, education and direct contact details will be published once reviewed and approved.</p><a class="btn secondary" href="/" data-pt="Voltar ao portfólio" data-en="Back to portfolio">Back to portfolio</a></div></section>
</main><SiteFooter />
<script is:inline src="/js/preferences.js" defer></script></body></html>