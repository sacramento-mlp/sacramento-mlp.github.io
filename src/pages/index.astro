---
import ContactPanel from '../components/ContactPanel.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import { publishedArticles } from '../data/articles';
const latestArticle = [...publishedArticles].sort((a,b)=>b.date.localeCompare(a.date))[0];
const products = [
 {slug:'diskguardian',name:'DiskGuardian',number:'01',icon:'◈',type:'PYTHON / WINDOWS',pt:'Análise e gestão de armazenamento com operações controladas e foco na segurança dos dados.',en:'Storage analysis and management with controlled operations and a focus on data safety.'},
 {slug:'windows-technical-toolkit',name:'Windows Technical Toolkit',number:'02',icon:'>_',type:'POWERSHELL / WINDOWS',pt:'Ferramentas para diagnóstico, manutenção e automação de tarefas em Windows.',en:'Tools for Windows diagnostics, maintenance and task automation.'},
 {slug:'domain-admin-toolkit',name:'Domain Admin Toolkit',number:'03',icon:'⌘',type:'POWERSHELL / ACTIVE DIRECTORY',pt:'Utilitários técnicos para apoiar a administração de ambientes Windows com domínio.',en:'Technical utilities supporting the administration of domain-based Windows environments.'}
];
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<link rel="icon" type="image/png" href="/brand/ms-logo.png"/>
<meta name="description" content="Mário Sacramento — information systems, technical support, networking and independent software projects."/>
<link rel="canonical" href="https://sacramento-mlp.github.io/"/>
<meta name="theme-color" content="#080f1d"/>
<meta property="og:type" content="website"/>
<meta property="og:title" content="Mário Sacramento | Information Systems & Technology"/>
<meta property="og:description" content="Information systems, technical support, networking and independent software projects."/>
<meta property="og:url" content="https://sacramento-mlp.github.io/"/>
<meta property="og:site_name" content="Mário Sacramento"/>
<meta property="og:locale" content="en_US"/>
<meta name="twitter:card" content="summary"/>
<meta name="twitter:title" content="Mário Sacramento | Information Systems & Technology"/>
<meta name="twitter:description" content="Information systems, technical support, networking and independent software projects."/>
<title>Mário Sacramento | Information Systems & Technology</title>
<script is:inline src="/js/preferences-init.js"></script>
</head>
<body>
<a class="skip-link" href="#main-content" data-pt="Saltar para o conteúdo principal" data-en="Skip to main content">Skip to main content</a>
<SiteHeader current="home" />
<main id="main-content" tabindex="-1"><span id="inicio" aria-hidden="true"></span>
<div class="hero-shell"><div class="wrap hero hero-grid">
<div class="hero-copy">
<div class="availability"><span class="status-dot"></span><span data-pt="PERFIL PROFISSIONAL & PORTFÓLIO" data-en="PROFESSIONAL PROFILE & PORTFOLIO">PROFESSIONAL PROFILE & PORTFOLIO</span></div>
<h1 data-pt="Sistemas e tecnologias de informação" data-en="Information systems & technology">Information systems &amp; technology</h1>
<p class="hero-name" data-pt="Administração de sistemas · Redes · Desenvolvimento" data-en="Systems administration · Networking · Development">Systems administration · Networking · Development</p>
<p class="lead" data-pt="Profissional de IT com percurso desde 2013 em telecomunicações, suporte técnico e sistemas de informação. Atualmente exerço funções na Administração Pública." data-en="IT professional with a career spanning telecommunications, technical support and information systems since 2013. Currently working in public administration.">IT professional with a career spanning telecommunications, technical support and information systems since 2013. Currently working in public administration.</p>
<div class="actions"><a class="btn" href="/cv/"><span data-pt="Ver currículo" data-en="View résumé">View résumé</span> <span aria-hidden="true">↗</span></a><a class="btn secondary" href="#contacto" data-pt="Entrar em contacto" data-en="Get in touch">Get in touch</a></div>
<div class="hero-meta"><span><span class="mini-dot"></span> PYTHON</span><span><span class="mini-dot"></span> POWERSHELL</span><span><span class="mini-dot"></span> WINDOWS</span></div>
</div>
<aside class="professional-card" aria-label="Career overview" data-aria-pt="Resumo do percurso" data-aria-en="Career overview">
<div class="section-kicker"><span class="kicker-line"></span><span data-pt="PERCURSO PROFISSIONAL" data-en="CAREER OVERVIEW">CAREER OVERVIEW</span></div>
<p class="career-current" data-pt="Técnico de Sistemas e Tecnologias de Informação" data-en="Information Systems and Technology Technician">Information Systems and Technology Technician</p>
<p class="muted" data-pt="PSP · Comando Distrital de Viana do Castelo" data-en="PSP · Viana do Castelo District Command">PSP · Viana do Castelo District Command</p>
<dl class="career-facts"><div><dt data-pt="Desde" data-en="Since">Since</dt><dd>2026</dd></div><div><dt data-pt="Percurso em IT e comunicações desde" data-en="IT and communications career since">IT and communications career since</dt><dd>2013</dd></div><div><dt data-pt="Formação modular" data-en="Modular training">Modular training</dt><dd><span data-pt="18 módulos" data-en="18 modules">18 modules</span></dd></div></dl>
<a class="profile-link" href="/cv/#experiencia" data-pt="Consultar experiência profissional" data-en="Explore career history">Explore career history</a></aside>
</div></div>
<section id="sobre" class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="01 / PERFIL" data-en="01 / PROFILE">01 / PROFILE</span></div><div class="about-grid"><div><h2 data-pt="Experiência técnica ao serviço de necessidades reais." data-en="Technical experience focused on real needs.">Technical experience focused on real needs.</h2></div><div><p class="lead" data-pt="O meu percurso inclui telecomunicações e sistemas informáticos no Exército Português. Desde novembro de 2026, sou Técnico de Sistemas e Tecnologias de Informação na PSP, no Comando Distrital de Viana do Castelo." data-en="My career includes telecommunications and IT systems in the Portuguese Army. Since November 2026, I have worked as an Information Systems and Technology Technician at the PSP, Viana do Castelo District Command.">My career includes telecommunications and IT systems in the Portuguese Army. Since November 2026, I have worked as an Information Systems and Technology Technician at the PSP, Viana do Castelo District Command.</p><p class="muted" data-pt="Os projetos pessoais de software e automação apresentados neste portal são independentes da minha atividade profissional." data-en="The personal software and automation projects featured here are independent of my professional employment.">The personal software and automation projects featured here are independent of my professional employment.</p><a class="profile-link" href="/cv/"><span data-pt="Ver perfil profissional" data-en="View professional profile">View professional profile</span><span aria-hidden="true"> ↗</span></a></div></div></section>
<section id="projetos" class="section-alt"><div class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="02 / COMPETÊNCIAS" data-en="02 / EXPERTISE">02 / EXPERTISE</span></div><div class="section-heading"><h2 data-pt="Áreas de especialização" data-en="Areas of focus">Areas of focus</h2><p class="muted" data-pt="Experiência profissional, formação técnica e projetos pessoais." data-en="Professional experience, technical training and personal projects.">Professional experience, technical training and personal projects.</p></div><div class="grid expertise-grid">
<article class="card expertise-card"><div class="expertise-icon">⌘</div><span class="tag">01 / DEVELOPMENT</span><h3 data-pt="Desenvolvimento de software" data-en="Software development">Software development</h3><p data-pt="Aplicações e utilitários orientados a necessidades concretas." data-en="Applications and utilities designed around real-world needs.">Applications and utilities designed around real-world needs.</p></article>
<article class="card expertise-card"><div class="expertise-icon">&gt;_</div><span class="tag">02 / AUTOMATION</span><h3 data-pt="Automação Windows" data-en="Windows automation">Windows automation</h3><p data-pt="Simplificação de tarefas repetitivas e fluxos técnicos." data-en="Streamlining repetitive tasks and technical workflows.">Streamlining repetitive tasks and technical workflows.</p></article>
<article class="card expertise-card"><div class="expertise-icon">▦</div><span class="tag">03 / SYSTEMS</span><h3 data-pt="Administração de sistemas e redes" data-en="Systems and network administration">Systems and network administration</h3><p data-pt="Experiência em suporte técnico, serviços de rede, Active Directory e comunicações." data-en="Experience in technical support, network services, Active Directory and communications.">Experience in technical support, network services, Active Directory and communications.</p></article>
</div></div></section>
<section id="produtos" class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="03 / SOFTWARE" data-en="03 / SOFTWARE">03 / SOFTWARE</span></div><div class="section-heading"><div><h2 data-pt="Produtos em desenvolvimento" data-en="Products in development">Products in development</h2><p class="muted" data-pt="Três produtos independentes, cada um com uma finalidade específica." data-en="Three independent products, each with its own technology.">Three independent products, each with its own technology.</p></div><span class="catalog-count">03 / PRODUCTS</span></div><div class="product-grid">{products.map(p=><article class="card product-card"><div class="product-top"><span class="product-number">{p.number} / 03</span><span class="product-status"><span class="mini-dot"></span><span data-pt="EM DESENVOLVIMENTO" data-en="IN DEVELOPMENT">IN DEVELOPMENT</span></span></div><div class="product-icon" aria-hidden="true">{p.icon}</div><div class="tag">{p.type}</div><h3>{p.name}</h3><p data-pt={p.pt} data-en={p.en}>{p.en}</p><div class="product-bottom"><a class="product-link" href={`/produtos/${p.slug}/`}><span data-pt="Ver detalhes" data-en="View details">View details</span><span aria-hidden="true">↗</span></a></div></article>)}</div><p class="product-disclaimer muted" data-pt="Os produtos apresentados ainda não estão disponíveis para compra." data-en="The products shown are not currently available for purchase.">The products shown are not currently available for purchase.</p></section>
<section id="artigos" class="section-alt"><div class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="04 / CONHECIMENTO" data-en="04 / KNOWLEDGE">04 / KNOWLEDGE</span></div><div class="articles-home-grid"><div><h2 data-pt="Conhecimento para partilhar." data-en="Knowledge worth sharing.">Knowledge worth sharing.</h2><p class="lead" data-pt="Artigos e guias técnicos sobre Windows, PowerShell, segurança e desenvolvimento de software." data-en="Technical articles and practical guides about Windows, PowerShell, security and software development.">Technical articles and practical guides about Windows, PowerShell, security and software development.</p><a class="btn secondary" href="/artigos/"><span data-pt="Explorar artigos" data-en="Explore articles">Explore articles</span> ↗</a></div><div class="articles-home-panel"><span class="tag">ARTICLES / GUIDES</span><div class="articles-home-symbol" aria-hidden="true">✦</div><strong data-pt="Aprender. Resolver. Partilhar." data-en="Learn. Solve. Share.">Learn. Solve. Share.</strong>{latestArticle ? <><p class="muted" data-pt="Artigo mais recente" data-en="Latest article">Latest article</p><a class="product-link" href={`/artigos/${latestArticle.slug}/`} data-pt={latestArticle.title.pt} data-en={latestArticle.title.en}>{latestArticle.title.en}</a></> : <p class="muted" data-pt="Uma biblioteca técnica em preparação." data-en="A technical library in preparation.">A technical library in preparation.</p>}</div></div></div></section>
<section id="contacto" class="contact-section"><div class="wrap contact-inner"><div><div class="section-kicker"><span class="kicker-line"></span><span data-pt="05 / CONTACTO" data-en="05 / CONTACT">05 / CONTACT</span></div><h2 data-pt="Vamos conversar." data-en="Let's get in touch.">Let's get in touch.</h2><p class="lead" data-pt="Tens uma proposta, questão ou oportunidade de colaboração? Envia-me um e-mail." data-en="Have a proposal, question or collaboration opportunity? Send me an email.">Have a proposal, question or collaboration opportunity? Send me an email.</p></div><ContactPanel /></div></section>
</main>
<SiteFooter home />
<script is:inline src="/js/preferences.js" defer></script>
</body></html>
