---
import ContactPanel from '../components/ContactPanel.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import { experience, education, training, modules } from '../data/professional-profile';
const skills=[
 {n:'01',title:'Software development',pt:'Desenvolvimento de software',detail:'Python · Application architecture',detailPt:'Python · Arquitetura de aplicações'},
 {n:'02',title:'Windows automation',pt:'Automação Windows',detail:'PowerShell · Technical workflows',detailPt:'PowerShell · Fluxos técnicos'},
 {n:'03',title:'Systems administration',pt:'Administração de sistemas',detail:'Windows · Domain environments',detailPt:'Windows · Ambientes de domínio'}
];
import SeoHead from '../components/SeoHead.astro';
import { locale, localPath, languageTag } from '../lib/locale';
const lang=locale(Astro.url.pathname);
const link=(path: string)=>localPath(path,lang);
---
<!doctype html><html lang={languageTag(lang)} data-theme="dark"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<link rel="icon" type="image/png" href="/brand/ms-logo.png"/><meta name="theme-color" content="#080f1d"/>
<SeoHead kind="profile" title={lang==='pt'?'Currículo profissional | Mário Sacramento':'Professional résumé | Mário Sacramento'} description={lang==='pt'?'Percurso profissional, formação e competências de Mário Sacramento em sistemas informáticos, redes e telecomunicações.':'Mário Sacramento — career history, education and technical skills in IT systems, networking and telecommunications.'}/>
<script is:inline src="/js/preferences-init.js"></script>
</head><body class="cv-page">
<a class="skip-link" href="#main-content" data-pt="Saltar para o conteúdo principal" data-en="Skip to main content">{lang==='pt'?("Saltar para o conteúdo principal"):("Skip to main content")}</a>
<SiteHeader current="cv" />
<main id="main-content" tabindex="-1">
<section class="cv-hero"><div class="wrap"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="PERFIL PROFISSIONAL" data-en="PROFESSIONAL PROFILE">{lang==='pt'?("PERFIL PROFISSIONAL"):("PROFESSIONAL PROFILE")}</span></div>
<div class="cv-hero-grid"><div><h1 data-pt="Currículo profissional" data-en="Professional résumé">{lang==='pt'?("Currículo profissional"):("Professional résumé")}</h1><p class="cv-role" data-pt="Sistemas e Tecnologias de Informação" data-en="Information Systems & Technology">{lang==='pt'?("Sistemas e Tecnologias de Informação"):("Information Systems & Technology")}</p><p class="lead" data-pt="Experiência em sistemas informáticos, suporte técnico, redes e telecomunicações desde 2013." data-en="Experience in IT systems, technical support, networks and telecommunications since 2013.">{lang==='pt'?("Experiência em sistemas informáticos, suporte técnico, redes e telecomunicações desde 2013."):("Experience in IT systems, technical support, networks and telecommunications since 2013.")}</p>
<div class="actions"><a class="btn" href={link("/#produtos")}><span data-pt="Explorar projetos" data-en="Explore projects">{lang==='pt'?("Explorar projetos"):("Explore projects")}</span> ↗</a><a class="btn secondary" href="https://github.com/sacramento-mlp" rel="noopener noreferrer">GitHub ↗</a></div></div>
<div class="cv-identity" aria-label={lang==='pt'?'Símbolo da marca MS de Mário Sacramento':'Mário Sacramento MS brand symbol'}><div class="cv-symbol-viewport"><img src="/brand/ms-logo.png" alt="" width="240" height="180" /></div></div></div></div></section>
<nav class="wrap cv-jump" aria-label={lang==='pt'?("Secções do currículo"):("Résumé sections")} data-aria-pt="Secções do currículo" data-aria-en="Résumé sections"><a href="#experiencia" data-pt="Experiência" data-en="Experience">{lang==='pt'?("Experiência"):("Experience")}</a><a href="#formacao" data-pt="Formação" data-en="Education">{lang==='pt'?("Formação"):("Education")}</a><a href={link("/#produtos")} data-pt="Projetos" data-en="Projects">{lang==='pt'?("Projetos"):("Projects")}</a></nav>
<section class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="01 / RESUMO" data-en="01 / SUMMARY">{lang==='pt'?("01 / RESUMO"):("01 / SUMMARY")}</span></div><div class="cv-two-col"><h2 data-pt="Tecnologia aplicada a necessidades concretas." data-en="Technology focused on real needs.">{lang==='pt'?("Tecnologia aplicada a necessidades concretas."):("Technology focused on real needs.")}</h2><div><p class="lead" data-pt="Percurso em telecomunicações e sistemas informáticos no Exército Português e, desde novembro de 2026, na carreira de Técnico de Sistemas e Tecnologias de Informação na PSP." data-en="A career in telecommunications and IT systems in the Portuguese Army and, since November 2026, as an Information Systems and Technology Technician at the PSP.">{lang==='pt'?("Percurso em telecomunicações e sistemas informáticos no Exército Português e, desde novembro de 2026, na carreira de Técnico de Sistemas e Tecnologias de Informação na PSP."):("A career in telecommunications and IT systems in the Portuguese Army and, since November 2026, as an Information Systems and Technology Technician at the PSP.")}</p><p class="muted" data-pt="Os projetos pessoais são independentes das funções profissionais." data-en="Personal projects are independent of professional employment.">{lang==='pt'?("Os projetos pessoais são independentes das funções profissionais."):("Personal projects are independent of professional employment.")}</p></div></div></section>
<section class="section-alt"><div class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="02 / ÁREAS TÉCNICAS" data-en="02 / TECHNICAL FOCUS">{lang==='pt'?("02 / ÁREAS TÉCNICAS"):("02 / TECHNICAL FOCUS")}</span></div><h2 data-pt="Áreas de atuação" data-en="Areas of focus">{lang==='pt'?("Áreas de atuação"):("Areas of focus")}</h2><div class="cv-skills">{skills.map(s=><article class="cv-skill"><span class="cv-skill-number">{s.n}</span><div><h3 data-pt={s.pt} data-en={s.title}>{lang==='pt'?(s.pt):(s.title)}</h3><p data-pt={s.detailPt} data-en={s.detail}>{lang==='pt'?(s.detailPt):(s.detail)}</p></div><span class="cv-skill-arrow" aria-hidden="true">↗</span></article>)}</div></div></section>
<section class="wrap section-space" id="experiencia"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="03 / EXPERIÊNCIA" data-en="03 / EXPERIENCE">{lang==='pt'?("03 / EXPERIÊNCIA"):("03 / EXPERIENCE")}</span></div><h2 data-pt="Percurso profissional" data-en="Career history">{lang==='pt'?("Percurso profissional"):("Career history")}</h2><ol class="career-timeline">{experience.map(e=><li class="career-entry"><div><p class="muted" data-pt={e.period.pt} data-en={e.period.en}>{lang==='pt'?(e.period.pt):(e.period.en)}</p><h3 data-pt={e.role.pt} data-en={e.role.en}>{lang==='pt'?(e.role.pt):(e.role.en)}</h3><p data-pt={e.organization.pt} data-en={e.organization.en}>{lang==='pt'?(e.organization.pt):(e.organization.en)}</p><p data-pt={e.description.pt} data-en={e.description.en}>{lang==='pt'?(e.description.pt):(e.description.en)}</p></div></li>)}</ol></section>
<section class="section-alt" id="formacao"><div class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="04 / FORMAÇÃO" data-en="04 / EDUCATION">{lang==='pt'?("04 / FORMAÇÃO"):("04 / EDUCATION")}</span></div><h2 data-pt="Habilitações e formação" data-en="Education and training">{lang==='pt'?("Habilitações e formação"):("Education and training")}</h2><div class="cv-skills education-grid">{education.map(e=><article class="cv-skill"><span class="cv-skill-number">{e.year}</span><div><h3 data-pt={e.pt} data-en={e.en}>{lang==='pt'?(e.pt):(e.en)}</h3><p>{e.institution}</p></div></article>)}{training.map(t=><article class="cv-skill"><span class="cv-skill-number">{t.year}</span><div><h3 data-pt={t.pt} data-en={t.en}>{lang==='pt'?(t.pt):(t.en)}</h3><p>{t.institution}</p><p class="muted" data-pt={t.note.pt} data-en={t.note.en}>{lang==='pt'?(t.note.pt):(t.note.en)}</p></div></article>)}</div><h3 data-pt="Formação modular certificada — INOVINTER" data-en="Certified modular training — INOVINTER">{lang==='pt'?("Formação modular certificada — INOVINTER"):("Certified modular training — INOVINTER")}</h3><details class="training-details"><summary><span data-pt="Consultar os 18 módulos (2022–2024)" data-en="View all 18 modules (2022–2024)">{lang==='pt'?("Consultar os 18 módulos (2022–2024)"):("View all 18 modules (2022–2024)")}</span></summary><ul class="training-list">{modules.map(m=><li><span data-pt={m.pt} data-en={m.en}>{lang==='pt'?(m.pt):(m.en)}</span> · {m.year} · UFCD {m.code}</li>)}</ul></details></div></section>
<section class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="05 / PROJETOS" data-en="05 / SELECTED PROJECTS">{lang==='pt'?("05 / PROJETOS"):("05 / SELECTED PROJECTS")}</span></div><div class="cv-two-col"><div><h2 data-pt="Projetos que estou a desenvolver." data-en="Projects in development.">{lang==='pt'?("Projetos que estou a desenvolver."):("Projects in development.")}</h2><p class="muted" data-pt="Cada projeto tem a sua própria página, âmbito e estado de desenvolvimento." data-en="Each project has its own page, scope and development status.">{lang==='pt'?("Cada projeto tem a sua própria página, âmbito e estado de desenvolvimento."):("Each project has its own page, scope and development status.")}</p></div><div class="cv-project-list"><a href={link("/produtos/diskguardian/")}><span>DiskGuardian</span><span>↗</span></a><a href={link("/produtos/windows-technical-toolkit/")}><span>Windows Technical Toolkit</span><span>↗</span></a><a href={link("/produtos/domain-admin-toolkit/")}><span>Domain Admin Toolkit</span><span>↗</span></a></div></div></section>
<section class="contact-section"><div class="wrap contact-inner"><div><div class="section-kicker"><span class="kicker-line"></span><span data-pt="06 / CONTACTO" data-en="06 / CONTACT">{lang==='pt'?("06 / CONTACTO"):("06 / CONTACT")}</span></div><h2 data-pt="Entrar em contacto." data-en="Get in touch.">{lang==='pt'?("Entrar em contacto."):("Get in touch.")}</h2><p class="lead" data-pt="Para questões profissionais ou sobre projetos pessoais, entra em contacto por e-mail." data-en="For professional enquiries or questions about personal projects, get in touch by email.">{lang==='pt'?("Para questões profissionais ou sobre projetos pessoais, entra em contacto por e-mail."):("For professional enquiries or questions about personal projects, get in touch by email.")}</p></div><ContactPanel /></div></section>
</main><SiteFooter />
<script is:inline src="/js/preferences.js" defer></script></body></html>