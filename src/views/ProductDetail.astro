---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import type { Product } from '../data/products';
const {product}=Astro.props as {product: Product};
import SeoHead from '../components/SeoHead.astro';
import { locale, localPath, languageTag } from '../lib/locale';
const lang=locale(Astro.url.pathname);
const link=(path: string)=>localPath(path,lang);
const productTypesPt: Record<string,string> = {'DESKTOP SOFTWARE':'SOFTWARE PARA COMPUTADOR','TECHNICAL UTILITIES':'UTILITÁRIOS TÉCNICOS','ADMINISTRATION UTILITIES':'UTILITÁRIOS DE ADMINISTRAÇÃO'};
const productType = lang==='pt' ? productTypesPt[product.type] ?? product.type : product.type;
---
<!doctype html><html lang={languageTag(lang)} data-theme="dark"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<link rel="icon" type="image/png" href="/brand/ms-logo.png"/><meta name="theme-color" content="#080f1d"/>
<SeoHead title={product.name+' — '+product[lang]+' | Mário Sacramento'} description={lang==='pt'?product.descriptionPt:product.descriptionEn}/>
<script is:inline src="/js/preferences-init.js"></script>
</head>
<body class="product-page">
<a class="skip-link" href="#main-content" data-pt="Saltar para o conteúdo principal" data-en="Skip to main content">{lang==='pt'?("Saltar para o conteúdo principal"):("Skip to main content")}</a>
<SiteHeader current="products" />
<main id="main-content" tabindex="-1">
<section class="product-hero"><div class="wrap">
<a class="back-link" href={link("/#produtos")}><span aria-hidden="true">←</span> <span data-pt="Voltar aos produtos" data-en="Back to products">{lang==='pt'?("Voltar aos produtos"):("Back to products")}</span></a>
<div class="product-hero-grid"><div class="product-hero-copy">
<div class="section-kicker"><span class="kicker-line"></span><span>{product.index} / 03 — {productType}</span></div>
<h1>{product.name}</h1>
<p class="product-subtitle" data-pt={product.pt} data-en={product.en}>{lang==='pt'?(product.pt):(product.en)}</p>
<p class="lead" data-pt={product.descriptionPt} data-en={product.descriptionEn}>{lang==='pt'?(product.descriptionPt):(product.descriptionEn)}</p>
<div class="product-meta"><span class="product-state"><span class="status-dot"></span><span data-pt="Em desenvolvimento" data-en="In development">{lang==='pt'?("Em desenvolvimento"):("In development")}</span></span><span class="product-tech">{product.tech}</span></div>
<div class="actions"><a class="btn" href={link("/#contacto")}><span data-pt="Contacto" data-en="Get in touch">{lang==='pt'?("Contacto"):("Get in touch")}</span><span aria-hidden="true">↗</span></a><a class="btn secondary" href={link("/#produtos")}><span data-pt="Explorar outros produtos" data-en="Explore other products">{lang==='pt'?("Explorar outros produtos"):("Explore other products")}</span></a></div>
</div>
<div class="product-showcase" aria-hidden="true"><div class="showcase-top"><span>MS / PRODUCT {product.index}</span><span class="showcase-pulse">{lang==='pt'?'● DESENVOLVIMENTO':'● DEVELOPMENT'}</span></div><div class="showcase-center"><div class="showcase-symbol">{product.mark}</div><div class="showcase-name">{product.name}</div><div class="showcase-tech">{product.tech}</div></div><div class="showcase-bottom"><span>{lang==='pt'?'SOLUÇÕES TECNOLÓGICAS':'TECHNOLOGY SOLUTIONS'}</span><span>{product.index} / 03</span></div></div>
</div></div></section>
<section class="wrap section-space"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="SOBRE O PROJETO" data-en="ABOUT THE PROJECT">{lang==='pt'?("SOBRE O PROJETO"):("ABOUT THE PROJECT")}</span></div><div class="product-about-grid"><div><h2 data-pt="Criado com uma finalidade clara." data-en="Built with a clear purpose.">{lang==='pt'?("Criado com uma finalidade clara."):("Built with a clear purpose.")}</h2><p class="muted" data-pt="Cada produto é desenvolvido de forma independente, com objetivos e âmbito próprios." data-en="Each product is developed independently, with its own goals and scope.">{lang==='pt'?("Cada produto é desenvolvido de forma independente, com objetivos e âmbito próprios."):("Each product is developed independently, with its own goals and scope.")}</p></div><div><p class="lead" data-pt={product.descriptionPt} data-en={product.descriptionEn}>{lang==='pt'?(product.descriptionPt):(product.descriptionEn)}</p><div class="focus-list">{product.focusEn.map((focus,i)=><div class="focus-item"><span class="focus-index">0{i+1}</span><span data-pt={product.focusPt[i]} data-en={focus}>{lang==='pt'?(product.focusPt[i]):(focus)}</span><span class="focus-icon" aria-hidden="true">↗</span></div>)}</div></div></div></section>
<section class="product-notice"><div class="wrap product-notice-inner"><div><div class="section-kicker"><span class="kicker-line"></span><span data-pt="ESTADO ATUAL" data-en="CURRENT STATUS">{lang==='pt'?("ESTADO ATUAL"):("CURRENT STATUS")}</span></div><h2 data-pt="Em desenvolvimento." data-en="Work in progress.">{lang==='pt'?("Em desenvolvimento."):("Work in progress.")}</h2><p class="muted" data-pt="Este produto ainda não está disponível para compra. As funcionalidades, os preços e a documentação serão publicados após validação." data-en="This product is not available for purchase yet. Features, pricing and documentation will be published after validation.">{lang==='pt'?("Este produto ainda não está disponível para compra. As funcionalidades, os preços e a documentação serão publicados após validação."):("This product is not available for purchase yet. Features, pricing and documentation will be published after validation.")}</p></div><a class="btn secondary" href="https://github.com/sacramento-mlp" rel="noopener noreferrer"><span data-pt="Ver perfil GitHub" data-en="Visit GitHub profile">{lang==='pt'?("Ver perfil GitHub"):("Visit GitHub profile")}</span> ↗</a></div></section>
<section class="wrap section-space product-next"><div class="section-kicker"><span class="kicker-line"></span><span data-pt="EXPLORAR MAIS" data-en="EXPLORE MORE">{lang==='pt'?("EXPLORAR MAIS"):("EXPLORE MORE")}</span></div><h2 data-pt="Outros produtos" data-en="Other products">{lang==='pt'?("Outros produtos"):("Other products")}</h2><div class="product-next-grid">
{[{slug:'diskguardian',name:'DiskGuardian',number:'01'},{slug:'windows-technical-toolkit',name:'Windows Technical Toolkit',number:'02'},{slug:'domain-admin-toolkit',name:'Domain Admin Toolkit',number:'03'}].filter(p=>p.slug!==product.slug).map(p=><a class="next-product-card" href={link(`/produtos/${p.slug}/`)}><span class="tag">{p.number} / 03</span><strong>{p.name}</strong><span class="next-arrow" aria-hidden="true">↗</span></a>)}
</div></section>
</main>
<SiteFooter />
<script is:inline src="/js/preferences.js" defer></script>
</body></html>